<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="How SpeechBridge works"
            android:textColor="@color/ink"
            android:textSize="28sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:contentDescription="A person speaking"
            android:scaleType="fitCenter"
            android:src="@drawable/illustration_speaking" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:text="SpeechBridge gives you short practice steps. You choose when to record. It can show a few estimates from the sound or visible mouth shapes."
            android:textColor="@color/ink"
            android:textSize="17sp" />

        <include layout="@layout/card_channel_microphone" />
        <include layout="@layout/card_channel_neck" />
        <include layout="@layout/card_channel_semg" />
        <include layout="@layout/card_channel_camera" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:text="The neck and skin sensors are not set up for lesson measurements in this app version. A measurement is only one part of a recording. It is not a grade or a diagnosis."
            android:textColor="@color/ink"
            android:textSize="17sp" />

        <Button
            android:id="@+id/how_works_learn_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="54dp"
            android:text="Back to Learn"
            android:textAllCaps="false"
            android:textSize="17sp" />
    </LinearLayout>
</ScrollView>
