<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Progress dashboard"
            android:textColor="@color/ink"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/progress_overview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:text="Progress overview"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/progress_achievements"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:text="Achievements"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/progress_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:text="Progress context"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/progress_lesson_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:text="Recent lesson activity"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/progress_sessions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:text="Speech-practice history"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/progress_practice_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:text="Recent voice practice"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <Button
            android:id="@+id/progress_history_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Open latest saved speech-review session"
            android:textAllCaps="false"
            android:textSize="17sp" />

        <Button
            android:id="@+id/progress_curriculum_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Return to curriculum"
            android:textAllCaps="false"
            android:textSize="17sp" />

        <Button
            android:id="@+id/progress_home_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Back to home"
            android:textAllCaps="false"
            android:textSize="17sp" />
    </LinearLayout>
</ScrollView>
