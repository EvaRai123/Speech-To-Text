<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:id="@+id/lesson_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My lessons"
            android:textColor="@color/purple"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lesson_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Lesson title"
            android:textColor="@color/ink"
            android:textSize="30sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/lesson_illustration"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/not_a_measurement_illustration"
            android:scaleType="fitCenter"
            android:src="@drawable/illustration_speaking" />

        <TextView
            android:id="@+id/lesson_objective"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="3dp"
            android:text="What will we do?"
            android:textColor="@color/ink"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/lesson_educational_explanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_background"
            android:lineSpacingExtra="3dp"
            android:padding="14dp"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/lesson_camera_explanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_background"
            android:padding="12dp"
            android:text="Optional on-device camera feedback observes visible mouth movement only. It cannot verify pronunciation or tongue placement. Images are not saved."
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:visibility="gone" />

        <androidx.camera.view.PreviewView
            android:id="@+id/lesson_camera_preview"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="10dp"
            android:contentDescription="Live front camera preview; frames are processed on this device and not saved"
            android:visibility="gone" />

        <TextView
            android:id="@+id/lesson_camera_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Camera is off."
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/lesson_camera_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="54dp"
            android:text="Start optional camera feedback"
            android:textAllCaps="false"
            android:visibility="gone" />

        <TextView
            android:id="@+id/lesson_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Turn 1 of 3"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/lesson_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="8dp"
            android:indeterminate="false"
            android:max="3"
            android:progress="0"
            android:progressBackgroundTint="@color/lavender"
            android:progressTint="@color/purple" />

        <LinearLayout
            android:id="@+id/lesson_prompt_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/lesson_self_assessment_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your turn"
                android:textColor="@color/purple"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lesson_prompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Aaa"
                android:textColor="@color/ink"
                android:textSize="34sp"
                android:textStyle="bold" />
        </LinearLayout>

        <EditText
            android:id="@+id/lesson_personal_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Your name (optional)"
            android:inputType="textPersonName|textCapWords"
            android:maxLength="40"
            android:singleLine="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/lesson_instructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="4dp"
            android:text="Short instruction"
            android:textColor="@color/ink"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_background"
            android:padding="12dp"
            android:text="Pause or stop if you feel pain, dizziness, discomfort, or voice strain."
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/lesson_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_background"
            android:padding="14dp"
            android:text="Ready when you are."
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/lesson_measurement_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_background"
            android:padding="14dp"
            android:text="Your recording feedback will appear here."
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/lesson_example_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:minHeight="54dp"
            android:text="Hear this example"
            android:textAllCaps="false"
            android:visibility="gone" />

        <Button
            android:id="@+id/lesson_step_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:minHeight="58dp"
            android:text="I've tried this step"
            android:textAllCaps="false"
            android:textSize="17sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/lesson_record_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:minHeight="58dp"
            android:text="Record my turn"
            android:textAllCaps="false"
            android:textSize="17sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/lesson_stop_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="54dp"
            android:text="Stop recording"
            android:textAllCaps="false"
            android:visibility="gone" />

        <Button
            android:id="@+id/lesson_replay_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="54dp"
            android:text="Replay my recording"
            android:textAllCaps="false"
            android:visibility="gone" />

        <Button
            android:id="@+id/lesson_rest_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="50dp"
            android:text="Take a short rest"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/lesson_skip_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="50dp"
            android:text="Skip this turn"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/lesson_next_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="58dp"
            android:text="Next turn"
            android:textAllCaps="false"
            android:textSize="17sp"
            android:visibility="gone" />

        <RadioGroup
            android:id="@+id/lesson_self_assessment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="How did that feel?"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />
        </RadioGroup>

        <Button
            android:id="@+id/lesson_finish_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:minHeight="58dp"
            android:text="Finish activity"
            android:textAllCaps="false"
            android:textSize="17sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/lesson_progress_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="View my progress"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/lesson_back_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Back to lessons"
            android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
