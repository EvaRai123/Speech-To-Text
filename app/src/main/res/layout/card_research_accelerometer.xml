<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="8dp" android:background="@drawable/card_background"
    android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
    <ImageView android:layout_width="64dp" android:layout_height="58dp"
        android:contentDescription="Planned neck sensor illustration" android:src="@drawable/illustration_wearable" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Accelerometer · neck vibration" android:textColor="@color/ink"
            android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/research_accelerometer_state" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Checking saved attempts."
            android:textColor="@color/ink" android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
